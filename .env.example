NODE_ENV=development

PORT=5000

API_PREFIX=/api/v1

# --- Managed Postgres (Render, Railway, Neon, etc.) ---
# Set this and it takes priority over every DB_* field below.
# Use the EXTERNAL connection string your provider gives you (the
# one with a full hostname like *.oregon-postgres.render.com),
# not an internal-only hostname — internal hostnames only resolve
# from inside that provider's own network.
DATABASE_URL=

# --- Local Postgres (used only when DATABASE_URL is unset) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_service
DB_USER=postgres
DB_PASSWORD=SecurePassw0rd

# Force SSL for discrete-field connections that need it (DATABASE_URL
# connections already get SSL automatically). Leave false for local dev.
DB_SSL=false

JWT_ISSUER=auth-service
JWT_AUDIENCE=auth-api


CORS_ORIGIN=http://localhost:3000,https://hoppscotch.io

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_FIRST_NAME=System
SUPER_ADMIN_LAST_NAME=Administrator
SUPER_ADMIN_PHONE=+1234567890

JWT_ACCESS_SECRET=replace-this-with-a-real-32-plus-char-secret-eg-openssl-rand-hex-32
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_EXPIRES_IN=7d
API_PREFIX=/api/v1